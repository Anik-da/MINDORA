# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
# Default model: gemini-3.5-flash-lite (configurable comparison: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# TinyFish REST API (leave blank until an authorized key is configured)
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://agent.tinyfish.ai
# Reserved: TinyFish webhook signature verification is not documented yet.
TINYFISH_WEBHOOK_SECRET=

# Required for private MINDORA web companion/dashboard sessions (minimum 24 characters).
# This is a workspace access token, separate from provider credentials.
MINDORA_WEB_ACCESS_TOKEN=replace_with_a_random_token_of_at_least_24_characters
